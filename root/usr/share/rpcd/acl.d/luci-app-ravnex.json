{
	"luci-app-ravnex": {
		"description": "Grant access to ravnex configuration",
		"read": {
			"file": {
				"/etc/ravnex/scripts/update_subscriptions.uc": [ "exec" ],
				"/usr/bin/ucode": [ "exec" ],
				"/etc/ravnex/zapret_candidates.json": [ "read" ],
				"/var/run/ravnex/ravnex.log": [ "read" ],
				"/var/run/ravnex/hiddify-c.log": [ "read" ]
			},
			"ubus": {
				"service": [ "list" ],
				"luci.ravnex": [
					"acllist_read", "connection_check", "singbox_generator", "singbox_get_features",
					"core_install_status", "core_skipped", "clash_ip_info", "clash_proxies", "clash_active_node",
					"hotswap_status", "monitor_nodes", "monitor_connections",
					"diag_core_check", "diag_config_check", "diag_dns_ru", "diag_nftables", "diag_report",
					"byedpi_status", "byedpi_check_update", "zapret_status", "zapret_check_update", "curl_status",
					"app_status", "app_check_update", "app_op_status", "app_op_list", "app_snapshot_list",
					"health_status", "sentinel_status", "recovery_status", "health_explain", "resource_status",
					"app_rulesets_local_status", "zapret_fuzz_status", "wizard_compose_status", "wizard_compose_build",
					"app_subscription_status", "app_import_nodes",
					"wizard_autopilot_status", "wizard_auto_pick_status", "automation_status", "automation_stats",
					"route_explain", "wizard_scan_status", "wizard_dpidetect_status", "wizard_service_check",
					"wizard_service_profile_status", "discovery_snapshot", "service_optimizer_plan",
					"zapret_device_verdicts",
					"wizard_preset_list", "wizard_dpi_status", "wizard_strategy_list", "wizard_strategy_status",
					"overview_metrics", "overview_sys", "telegram_status", "automation_geo_diag",
					"res_profile",
					"mosdns_status", "mosdns_check_update", "multidns_status", "diag_dns_multidns",
					"automation_list_read", "automation_backup", "automation_geo_status",
					"lists_list", "list_read", "list_export", "list_backup_list", "list_backup_read",
					"lists_conveyor_status", "lab_strategy_source_status",
					"control_status", "control_devices", "control_wifi_status", "control_events", "control_log_tail",
					"app_support_bundle_status", "app_support_bundle_chunk", "app_support_bundle_text_status",
					"feed_status"
				]
			},
			"uci": [ "ravnex" ]
		},
		"write": {
			"file": {
				"/tmp/ravnex_certificate.tmp": [ "write" ]
			},
			"ubus": {
				"luci.ravnex": [
					"acllist_write", "certificate_write", "server_cert_generate", "log_clean", "core_install_start", "core_rollback_tags", "detect_custom_core",
					"app_subscription_update_start", "app_subscription_add", "app_subscription_remove",
					"monitor_connections_close", "diag_config_heal", "diag_service_restart",
					"byedpi_prepare_install", "byedpi_install_pkg", "byedpi_remove",
					"zapret_prepare_install", "zapret_install_pkg", "zapret_remove",
					"zapret_resolve_hosts", "zapret_strategy_test", "byedpi_strategy_test",
					"curl_install", "curl_remove",
					"app_prepare_install", "app_install_pkg", "app_update_start", "app_snapshot_create", "app_snapshot_restore",
					"app_rulesets_local_seed", "app_restore_internet",
					"zapret_fuzz_start", "zapret_fuzz_apply", "zapret_device_verdict_set",
					"wizard_compose_run", "wizard_compose_apply", "wizard_compose_rollback", "wizard_compose_save",
					"wizard_dpi_probe", "wizard_autopilot_set", "wizard_autopilot_hold_release", "wizard_byedpi_set", "wizard_auto_pick_start",
					"wizard_provider_scan", "wizard_dpidetect_update", "wizard_ai_nodes_check",
					"wizard_service_profile_run",
					"wizard_preset_apply", "wizard_preset_delete", "wizard_strategy_update",
					"wizard_strategy_apply", "wizard_corpus_import", "wizard_fuzz_generate",
					"telegram_set", "telegram_test", "telegram_preview", "telegram_pair_generate", "telegram_user_remove", "automation_helpers_install",
					"telegram_flag_set", "telegram_bind_set", "telegram_pair_consume",
					"control_service_set", "control_mode_set", "control_safe_set",
					"mosdns_prepare_install", "mosdns_install_pkg", "mosdns_remove",
					"multidns_disable", "multidns_reload", "multidns_reset",
					"automation_clear", "automation_clear_log",
					"automation_list_write", "automation_test_now", "automation_restore", "automation_recheck",
					"automation_entry_add", "automation_entry_delete", "automation_entry_action", "automation_geo_update",
					"automation_geo_protect_set",
					"list_create", "list_delete", "list_write", "list_import", "list_update",
					"list_backup_create", "list_backup_restore", "wizard_preset_add",
					"lists_conveyor_update_start", "lab_strategy_import_start",
					"control_set", "control_set_paused", "recovery_action",
					"control_client_add", "control_client_delete", "control_client_rename", "control_client_block",
					"control_client_temp_block", "control_client_temp_allow", "control_client_wifi_block",
					"control_client_temp_unblock",
					"control_rule_add", "control_rule_delete", "control_rule_toggle", "control_rule_pause",
					"control_rule_resume", "control_schedule_add", "control_schedule_delete", "control_schedule_toggle",
					"control_wifi_set", "control_wifi_temp", "control_wifi_temp_clear", "control_events_clear",
					"control_proxy_global", "control_proxy_mode", "control_proxy_lists",
					"res_profile_set",
					"feed_setup", "feed_remove", "install_feed_pkg",
					"app_support_bundle_start", "app_support_bundle_text_start"
				]
			},
			"uci": [ "ravnex" ]
		}
	}
}
