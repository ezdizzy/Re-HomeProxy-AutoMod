#!/bin/sh

# Register the Ravnex theme and make it the default only while the LuCI
# theme is still the untouched stock one - a deliberate user choice of
# another theme is never overridden (ch.137).

uci -q set luci.themes.Ravnex="/luci-static/ravnex"

if [ "$(uci -q get luci.main.mediaurlbase)" = "/luci-static/bootstrap" ]; then
	uci -q set luci.main.mediaurlbase="/luci-static/ravnex"
fi

uci -q commit luci

exit 0
