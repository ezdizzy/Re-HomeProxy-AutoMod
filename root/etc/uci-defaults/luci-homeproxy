#!/bin/sh

[ -f "/www/luci-static/resources/icons/loading.gif" ] && \
	sed -i "s,/loading.svg,/loading.gif,g" "/www/luci-static/resources/view/homeproxy/status.js"

uci -q batch <<-EOF >"/dev/null"
	delete firewall.ravnex_pre

	delete firewall.ravnex_forward
	set firewall.ravnex_forward=include
	set firewall.ravnex_forward.type=nftables
	set firewall.ravnex_forward.path="/var/run/ravnex/fw4_forward.nft"
	set firewall.ravnex_forward.position="chain-pre"
	set firewall.ravnex_forward.chain="forward"

	delete firewall.ravnex_input
	set firewall.ravnex_input=include
	set firewall.ravnex_input.type=nftables
	set firewall.ravnex_input.path="/var/run/ravnex/fw4_input.nft"
	set firewall.ravnex_input.position="chain-pre"
	set firewall.ravnex_input.chain="input"

	delete firewall.ravnex_post
	set firewall.ravnex_post=include
	set firewall.ravnex_post.type=nftables
	set firewall.ravnex_post.path="/var/run/ravnex/fw4_post.nft"
	set firewall.ravnex_post.position="table-post"
	commit firewall
EOF

exit 0
