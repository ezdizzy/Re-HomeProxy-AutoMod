msgstr "Импортирую %d стратегий…"

msgid "Import failed: "
msgstr "Импорт не удался: "

msgid "Corpus updated: +%d imported, %d already present, %d invalid — %d strategies total. Run a fuzz to rank the new entries."
msgstr "Корпус обновлён: +%d импортировано, %d уже было, %d некорректных — всего %d стратегий. Запустите фаззинг, чтобы ранжировать новые записи."

